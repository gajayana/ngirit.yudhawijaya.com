/**
 * Cloudflare Workers config for ngirit.
 *
 * Nitro merges this file into `.output/server/wrangler.json` at build time and
 * injects `main` + the `ASSETS` binding itself — do not set those here.
 *
 * Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "com-yudhawijaya-ngirit",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Binds the Worker to the apex-zone subdomain. Wrangler creates the DNS
  // record on deploy, so the zone must have NO existing record for this name.
  "routes": [
    {
      "pattern": "ngirit.yudhawijaya.com",
      "custom_domain": true
    }
  ],
  // Keeps vars set in the Cloudflare dashboard instead of deleting them on
  // deploy. Without this, `wrangler deploy` treats this file as the sole source
  // of truth and wipes anything set in the dashboard.
  "keep_vars": true,

  // Only non-sensitive values live here. The Supabase URL and publishable key
  // are set in the dashboard (Worker -> Settings -> Variables and Secrets) and
  // preserved across deploys by `keep_vars` above:
  //   NUXT_PUBLIC_SUPABASE_URL
  //   NUXT_PUBLIC_SUPABASE_KEY
  //
  // Nuxt maps NUXT_* env vars onto runtimeConfig on every request and puts the
  // `public` half into the SSR payload, so these reach the browser too and
  // override whatever the local .env baked in at build time.
  "vars": {
    "NUXT_PUBLIC_HOST": "https://ngirit.yudhawijaya.com"
  }
  // Secrets are NOT stored here. Set them with:
  //   pnpm wrangler secret put NUXT_SUPABASE_SECRET_KEY
}
