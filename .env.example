# Canonical list of variables read by nuxt.config.ts.
#
# These are your LOCAL values (local Supabase CLI etc.). `nuxt build` bakes them
# into the bundle; on Cloudflare they are overridden at runtime by the `vars`
# block in wrangler.jsonc, so local values here are fine.
NUXT_PUBLIC_HOST=http://localhost:3000
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_KEY=

# Server-only. On Cloudflare set as a Worker secret named
# NUXT_SUPABASE_SECRET_KEY (secrets survive `wrangler deploy`; plain vars in the
# dashboard do not):
SUPABASE_SECRET_KEY=

# --- Local one-off data-migration scripts only (pnpm firestore:fetch). ---
# Not needed to build, run, or deploy the app.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_AUTH_EMAIL=
FIREBASE_AUTH_PASSWORD=
