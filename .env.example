# Canonical list of variables read by nuxt.config.ts.
#
# BUILD TIME (baked into the bundle by `nuxt build` — must be present when you
# build, whether locally or in Cloudflare Workers Builds):
NUXT_PUBLIC_HOST=http://localhost:3000
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_KEY=

# RUNTIME (server-only; on Cloudflare set as a Worker secret named
# NUXT_SUPABASE_SECRET_KEY so it can be rotated without a rebuild):
SUPABASE_SECRET_KEY=

# --- Local one-off data-migration scripts only (pnpm firestore:fetch). ---
# Not needed to build, run, or deploy the app.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_AUTH_EMAIL=
FIREBASE_AUTH_PASSWORD=
